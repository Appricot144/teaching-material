#!/usr/bin/env node
// 教材の figures/ ディレクトリにある HTML の図を、同じ名前の PNG に変換する。
//
//   bin/figures              すべての figures/*.html を PNG にする
//   bin/figures FILE.html…   指定した figures/*.html だけを PNG にする（パスは作業ディレクトリから）
//   bin/figures --check      古い PNG（元の HTML が変わった、または元の HTML がない）を表示し、あれば失敗する
//
// 図の HTML では、画像にしたい要素に class="figure" を付ける。その要素だけを、2倍の解像度で撮る。
// できた PNG はコミットする（GitHub で Markdown を見たときにも図が出るように）。
//
// PNG には、元の HTML のハッシュ値を書き込んでおく。--check はこの値と今の HTML を比べる。
// ファイルの更新日時は、git のチェックアウトで変わってしまうので使わない。
const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');

const root = path.resolve(__dirname, '..');
const puppeteer = require(path.join(root, 'node_modules', 'puppeteer'));
const config = require(path.join(root, '.puppeteerrc.cjs'));

// 教材以外のディレクトリは探さない
const skip = new Set(['.git', 'node_modules', 'dist', 'bin', 'build', 'test', '.claude']);

// figures/ ディレクトリの中の、指定した拡張子のファイルを探す
function findInFigures(dir, ext) {
  const found = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (skip.has(entry.name)) continue;
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      found.push(...findInFigures(full, ext));
    } else if (entry.name.endsWith(ext) && path.basename(dir) === 'figures') {
      found.push(full);
    }
  }
  return found;
}

// --- PNG の tEXt チャンクに、元の HTML のハッシュ値を読み書きする ---

const KEYWORD = 'figure-source-sha256';

function sha256(file) {
  return crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
}

const crcTable = Array.from({ length: 256 }, (_, n) => {
  let c = n;
  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c >>> 0;
});

function crc32(buf) {
  let c = 0xffffffff;
  for (const b of buf) c = crcTable[(c ^ b) & 0xff] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
}

// IEND チャンクの直前に tEXt チャンクを入れる
function withSourceHash(png, hash) {
  const data = Buffer.from(`${KEYWORD}\0${hash}`, 'latin1');
  const type = Buffer.from('tEXt', 'latin1');
  const chunk = Buffer.alloc(12 + data.length);
  chunk.writeUInt32BE(data.length, 0);
  type.copy(chunk, 4);
  data.copy(chunk, 8);
  chunk.writeUInt32BE(crc32(Buffer.concat([type, data])), 8 + data.length);
  const iend = png.length - 12;
  return Buffer.concat([png.subarray(0, iend), chunk, png.subarray(iend)]);
}

// PNG に書き込んだハッシュ値を読む。なければ null
function readSourceHash(file) {
  const png = fs.readFileSync(file);
  let pos = 8;
  while (pos + 8 <= png.length) {
    const length = png.readUInt32BE(pos);
    const type = png.toString('latin1', pos + 4, pos + 8);
    if (type === 'tEXt') {
      const [key, value] = png.toString('latin1', pos + 8, pos + 8 + length).split('\0');
      if (key === KEYWORD) return value;
    }
    pos += 12 + length;
  }
  return null;
}

// 古い PNG を返す。元の HTML がないものと、元の HTML のハッシュ値が違うもの
function findStale() {
  return findInFigures(root, '.png').sort().filter((png) => {
    const html = png.replace(/\.png$/, '.html');
    return !fs.existsSync(html) || readSourceHash(png) !== sha256(html);
  });
}

// 指定されたファイルが、figures/ の中の存在する HTML かを確かめる。違えば理由を返す
function invalidReason(file) {
  if (!file.endsWith('.html')) return 'HTML ファイルではありません';
  if (path.basename(path.dirname(file)) !== 'figures') return 'figures/ の中のファイルではありません';
  if (!fs.existsSync(file)) return 'ファイルがありません';
  return null;
}

function check() {
  const stale = findStale();
  for (const png of stale) console.log(path.relative(root, png));
  return stale.length === 0;
}

async function main() {
  if (process.argv[2] === '--check') {
    if (!check()) process.exit(1);
    return;
  }

  const args = process.argv.slice(2);
  let figures;
  if (args.length > 0) {
    figures = args.map((arg) => path.resolve(arg));
    // 1つでも図でないものがあれば、何も作らずに止める
    const errors = figures
      .map((file, i) => [args[i], invalidReason(file)])
      .filter(([, reason]) => reason);
    if (errors.length > 0) {
      for (const [arg, reason] of errors) console.error(`${arg}: ${reason}`);
      process.exit(1);
    }
  } else {
    figures = findInFigures(root, '.html').sort();
  }
  if (figures.length === 0) {
    console.log('図はありません');
    return;
  }

  const browser = await puppeteer.launch({ executablePath: config.executablePath });
  try {
    const page = await browser.newPage();
    await page.setViewport({ width: 1200, height: 800, deviceScaleFactor: 2 });
    for (const html of figures) {
      await page.goto('file://' + html, { waitUntil: 'load' });
      const figure = await page.$('.figure');
      if (!figure) {
        throw new Error(`class="figure" の要素がありません: ${path.relative(root, html)}`);
      }
      const png = html.replace(/\.html$/, '.png');
      const shot = Buffer.from(await figure.screenshot());
      fs.writeFileSync(png, withSourceHash(shot, sha256(html)));
      console.log(path.relative(root, png));
    }
  } finally {
    await browser.close();
  }
}

main().catch((err) => {
  console.error(err.message);
  process.exit(1);
});
